# AniWhere public frontend mode.
# "demo" uses explicit fictional fixtures.
# Do not switch to "pilot" until a reviewed pilot repository adapter is wired.
PUBLIC_DATA_MODE=demo

# Optional Ani assistant UI. Set false to hide the assistant without affecting AniWhere.
PUBLIC_ANI_ENABLED=true

# Development/test only. Production defaults to Gemini Live when omitted.
# PUBLIC_ANI_PROVIDER=mock

# Public URL of the deployed secure token-minting endpoint.
# Example: your Supabase Edge Function URL. Never put GEMINI_API_KEY here.
PUBLIC_ANI_SESSION_ENDPOINT=

# Server/Edge Function only:
# ANI_MODEL=gemini-3.8-live
# GEMINI_API_KEY=
# ANI_ALLOWED_ORIGINS=https://your-production-origin.example

# Ops/CI only — used by pnpm routing:generate. Never expose as PUBLIC_*.
# ORS_API_KEY=
# ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2
