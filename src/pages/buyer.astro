---
import BaseLayout from '../layouts/BaseLayout.astro';
import BagsakanWorkspace from '../components/bagsakan/BagsakanWorkspace.svelte';

const lang = Astro.url.searchParams.get('lang') === 'fil' ? 'fil' : 'en';
const isFil = lang === 'fil';

const title = isFil
  ? 'AniWhere — Iyong bagsakan'
  : 'AniWhere — Your bagsakan';

const description = isFil
  ? 'Itala ang pangangailangan sa pagbili sa device na ito.'
  : 'Record your buying needs on this device.';
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/buyer"
  lang={lang}
>
  <BagsakanWorkspace client:load initialLang={lang} />
</BaseLayout>
