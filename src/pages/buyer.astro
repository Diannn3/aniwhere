---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyerWorkspace from '../components/buyer/BuyerWorkspace.svelte';

const lang = (Astro.url.searchParams.get('lang') as 'en' | 'fil') || 'en';
const isFil = lang === 'fil';

const title = isFil
  ? 'AniWhere — Mga Alok sa Pagbili'
  : 'AniWhere — Your Buying Offers';

const description = isFil
  ? 'Pamamahala ng mga alok sa pagbili ng ani para sa mga buyer sa Laguna.'
  : 'Manage crop buying offers for agricultural buyers in Laguna.';
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/buyer"
  lang={lang}
>
  <BuyerWorkspace client:load initialLang={lang} />
</BaseLayout>
