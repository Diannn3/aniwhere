---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiscoveryExperience from '../components/discovery/DiscoveryExperience.svelte';
import { parseDiscoverQuery } from '../lib/state/url-state';

const parsedQuery = parseDiscoverQuery(Astro.url.searchParams);
const { lang } = parsedQuery;
const isFil = lang === 'fil';
const title = isFil ? 'AniWhere — Mga posibleng pamilihan' : 'AniWhere — Market Options';
const description = isFil
  ? 'Suriin at ihambing ang mga posibleng mapagbebentahan ng ani sa Laguna.'
  : 'Explore and compare potential outlets for your harvest in Laguna.';
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/discover"
  lang={lang}
>
  <script is:inline>
    const requestedView = new URLSearchParams(location.search).get('view');
    document.documentElement.dataset.discoverInitialView = requestedView === 'map' || requestedView === 'list'
      ? requestedView
      : matchMedia('(min-width: 1024px)').matches ? 'map' : 'list';
  </script>
  <DiscoveryExperience client:load initialQuery={parsedQuery} />
</BaseLayout>
