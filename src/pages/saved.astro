---
import BaseLayout from '../layouts/BaseLayout.astro';
import SavedOutletsExperience from '../components/saved/SavedOutletsExperience.svelte';

const title = 'AniWhere — Saved Outlets';
const description = 'Review outlets you have saved locally on this device. Compare terms or prepare for your harvest haul.';
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/saved"
>
  <SavedOutletsExperience client:only="svelte">
    <p slot="fallback" role="status" class="mx-auto max-w-5xl px-4 py-8 text-base">Binubuksan ang mga na-save… / Opening saved outlets…</p>
  </SavedOutletsExperience>
</BaseLayout>
