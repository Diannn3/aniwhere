---
import BaseLayout from '../layouts/BaseLayout.astro';
import SavedOutletsExperience from '../components/saved/SavedOutletsExperience.svelte';

const lang = Astro.url.searchParams.get('lang') === 'fil' ? 'fil' : 'en';
const title = lang === 'fil' ? 'AniWhere — Mga Nai-save na Lugar' : 'AniWhere — Saved Outlets';
const description = lang === 'fil'
  ? 'Balikan ang mga lugar na nai-save sa device na ito at suriin muli ayon sa kasalukuyang ani.'
  : 'Revisit outlets saved on this device and check them again against your current harvest.';
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/saved"
  lang={lang}
>
  <SavedOutletsExperience client:load initialLang={lang} />
</BaseLayout>
