---
import BaseLayout from '../layouts/BaseLayout.astro';
import HarvestForm from '../components/harvest/HarvestForm.svelte';

const langParam = Astro.url.searchParams.get('lang');
const lang = langParam === 'en' ? 'en' : 'fil';
const isFil = lang === 'fil';
---

<BaseLayout
  title={isFil ? 'AniWhere — Ano ang aanihin mo?' : 'AniWhere — What are you harvesting?'}
  description={isFil ? 'Maghanap ng mapagbibilhan ng ani mo sa Laguna. Sabihin ang iyong ani at ipapakita namin kung saan ito maaaring dalhin.' : 'Find places to sell your harvest in Laguna. Tell us your crop, volume, and origin.'}
  lang={lang}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    
    <!-- Hero Header: Direct H1 without Eyebrow (Strict Anti-Vibecode Rule #9) -->
    <div class="max-w-2xl mb-6 sm:mb-8">
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#20251E] leading-[1.12]" data-label-en="What are you harvesting?" data-label-fil="Ano ang aanihin mo?">{isFil ? 'Ano ang aanihin mo?' : 'What are you harvesting?'}</h1>
      <p class="mt-3 text-base sm:text-xl text-[#4A5245] font-normal leading-relaxed" data-label-en="Find places to sell your harvest in Laguna." data-label-fil="Maghanap ng mapagbibilhan ng ani mo sa Laguna.">
        {isFil ? 'Maghanap ng mapagbibilhan ng ani mo sa Laguna.' : 'Find places to sell your harvest in Laguna.'}
      </p>
    </div>

    <!-- Desktop Split / Mobile Stacked Composition -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Form Column: Immediate Access (7 cols on desktop, primary on mobile) -->
      <div class="lg:col-span-7 order-1 lg:order-1">
        
        <!-- Desktop Visual Header Strip (Hidden on mobile to preserve vertical ergonomics) -->
        <div class="hidden sm:block relative w-full h-36 sm:h-40 bg-[#FCECD8] rounded-2xl overflow-hidden mb-4 border border-[#20251E]/10 select-none shadow-xs">
          <!-- Agricultural Landscape Texture Artwork (SVG) -->
          <svg class="w-full h-full object-cover" viewBox="0 0 600 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Sky Gradient Warmth -->
            <rect width="600" height="200" fill="#FFFDF8" />
            <rect width="600" height="120" fill="#FCECD8" opacity="0.6" />
            <!-- Distant Mt. Makiling Mountain Silhouette -->
            <path d="M0 160L120 90L260 160H0Z" fill="#91AC67" opacity="0.4" />
            <path d="M180 160L350 70L520 160H180Z" fill="#597928" opacity="0.3" />
            <path d="M400 160L540 100L600 130V160H400Z" fill="#91AC67" opacity="0.35" />
            <!-- Rice/Vegetable Field Parcels with Perspective Grid -->
            <path d="M0 160H600V200H0V160Z" fill="#597928" opacity="0.85" />
            <line x1="300" y1="160" x2="100" y2="200" stroke="#FFFDF8" stroke-width="1.5" opacity="0.5" />
            <line x1="300" y1="160" x2="300" y2="200" stroke="#FFFDF8" stroke-width="1.5" opacity="0.5" />
            <line x1="300" y1="160" x2="500" y2="200" stroke="#FFFDF8" stroke-width="1.5" opacity="0.5" />
            <!-- Sun Warmth -->
            <circle cx="350" cy="70" r="32" fill="#FFFDF8" opacity="0.7" />
          </svg>

          <!-- Honest Demo Label Badge on Bottom Right -->
          <div class="absolute bottom-3 right-3 bg-[#FFFDF8]/95 backdrop-blur-sm border border-[#20251E]/15 px-2.5 py-1 rounded-full text-xs font-semibold text-[#6E3511] shadow-xs">
            <span data-label-en="Demo — sample data" data-label-fil="Demo — halimbawang datos">{isFil ? 'Demo — halimbawang datos' : 'Demo — sample data'}</span>
          </div>
          <div class="absolute top-3 left-3 bg-[#597928]/90 text-[#FFFDF8] px-2.5 py-1 rounded-full text-xs font-medium">
            <span data-label-en="Tomatoes, Eggplant, Calamansi" data-label-fil="Kamatis, Talong, Kalamansi">{isFil ? 'Kamatis, Talong, Kalamansi' : 'Tomatoes, Eggplant, Calamansi'}</span>
          </div>
        </div>

        <!-- The Harvest Entry Form -->
        <HarvestForm client:only="svelte" initialLang={lang}>
          <p slot="fallback" role="status" class="rounded-2xl border border-[#20251E]/12 bg-[#FFFDF8] p-4 text-base">Binubuksan ang form ng ani… / Opening harvest form…</p>
        </HarvestForm>
      </div>

      <!-- Map & Regional Context Column (5 cols on desktop, secondary on mobile) -->
      <div class="lg:col-span-5 order-2 lg:order-2 space-y-5 mt-6 lg:mt-0">
        
        <!-- Illustrative Map Card matching Reference 02 -->
        <div class="bg-[#FFFDF8] border border-[#20251E]/12 rounded-2xl p-5 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-bold text-[#20251E] flex items-center gap-2">
              <svg class="w-4 h-4 text-[#597928]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <span data-label-en="Laguna Market Corridor" data-label-fil="Mga Pamilihan sa Laguna">{isFil ? 'Mga Pamilihan sa Laguna' : 'Laguna Market Corridor'}</span>
            </h2>
            <span class="text-[10px] font-semibold text-[#6E3511] bg-[#FCECD8] px-2 py-0.5 rounded-full uppercase tracking-wider">
              <span data-label-en="Illustrative map" data-label-fil="Halimbawang mapa">{isFil ? 'Halimbawang mapa' : 'Illustrative map'}</span>
            </span>
          </div>

          <!-- Topographical Schematic SVG Map of Laguna de Bay -->
          <div class="relative h-56 w-full bg-[#F5F8F2] rounded-xl border border-[#20251E]/10 overflow-hidden flex items-center justify-center p-3 select-none">
            <svg class="w-full h-full" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Water body: Laguna de Bay -->
              <path d="M50 30C100 25 150 40 200 30C250 20 280 35 310 25V100C270 105 230 90 180 98C130 105 80 88 40 98V30Z" fill="#4E7380" opacity="0.25" />
              <text x="180" y="65" font-family="'Source Sans 3', sans-serif" font-size="11" fill="#4E7380" font-weight="700" text-anchor="middle" opacity="0.8">
                Laguna de Bay
              </text>

              <!-- Mt. Makiling Contour -->
              <path d="M60 190L130 130L200 190Z" fill="#91AC67" opacity="0.35" />
              <text x="130" y="175" font-family="'Source Sans 3', sans-serif" font-size="9" fill="#597928" font-weight="700" text-anchor="middle">
                Mt. Makiling
              </text>

              <!-- Harvest route connection line -->
              <path d="M130 130L250 85" stroke="#597928" stroke-width="2.5" stroke-linecap="round" />
              <path d="M130 130L80 105" stroke="#597928" stroke-width="2" stroke-dasharray="3 3" />

              <!-- Origin Pin: Los Baños -->
              <circle cx="130" cy="130" r="7" fill="#597928" />
              <circle cx="130" cy="130" r="3" fill="#FFFDF8" />
              <text x="130" y="148" font-family="'Source Sans 3', sans-serif" font-size="10" fill="#20251E" font-weight="700" text-anchor="middle">
                Los Baños
              </text>

              <!-- Destination Pins -->
              <circle cx="250" cy="85" r="6" fill="#597928" />
              <circle cx="250" cy="85" r="2.5" fill="#FFFDF8" />
              <text x="250" y="75" font-family="'Source Sans 3', sans-serif" font-size="9" fill="#20251E" font-weight="700" text-anchor="middle">
                Santa Cruz (Coop)
              </text>

              <circle cx="80" cy="105" r="5" fill="#6E3511" />
              <text x="80" y="95" font-family="'Source Sans 3', sans-serif" font-size="9" fill="#6E3511" font-weight="700" text-anchor="middle">
                Calamba (Processor)
              </text>
            </svg>
          </div>

          <p class="text-sm text-[#6B7265] mt-3 leading-relaxed" data-label-en="This map shows approximate locations and straight-line connections, not driving routes. Confirm terms before travel." data-label-fil="Tantiyang lokasyon at tuwirang guhit lamang ito, hindi ruta sa kalsada. Kumpirmahin ang kondisyon bago bumiyahe.">
            {isFil 
              ? 'Ang mga distansya at biyahe ay tinatantya lamang. Kumpirmahin muna ang kondisyon ng pagtanggap bago magkarga ng sasakyan.'
              : 'Locations and routes are schematic illustrations. Confirm receiving capacity with buyers prior to dispatch.'}
          </p>
        </div>

        <!-- 3 Value Pillars matching Reference 02 -->
        <div class="space-y-3">
          <div class="flex items-start gap-3.5 p-4 bg-[#FFFDF8] border border-[#20251E]/10 rounded-xl">
            <div class="w-9 h-9 rounded-full bg-[#597928]/15 flex items-center justify-center shrink-0 text-[#597928]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 21s-8-7.5-8-12a8 8 0 1116 0c0 4.5-8 12-8 12zM12 11a3 3 0 100-6 3 3 0 000 6z" />
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#20251E]" data-label-en="Find nearby options" data-label-fil="Maghanap ng kalapit na opsyon">
                {isFil ? 'Maghanap ng kalapit na opsyon' : 'Find nearby options'}
              </h3>
              <p class="text-sm text-[#4A5245] mt-0.5" data-label-en="Explore potential local outlets and see what still needs confirmation." data-label-fil="Tuklasin ang mga potensyal na pamilihan at alamin ang kailangan pang kumpirmahin.">
                {isFil ? 'Tuklasin ang mga potensyal na pamilihan at makita kung ano ang kailangan pang kumpirmahin.' : 'Explore potential local outlets and see what still needs confirmation.'}
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3.5 p-4 bg-[#FFFDF8] border border-[#20251E]/10 rounded-xl">
            <div class="w-9 h-9 rounded-full bg-[#FCECD8] flex items-center justify-center shrink-0 text-[#6E3511]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#20251E]" data-label-en="Check your harvest fit" data-label-fil="Suriin ang antas ng tugma">
                {isFil ? 'Suriin ang antas ng tugma' : 'Check your harvest fit'}
              </h3>
              <p class="text-sm text-[#4A5245] mt-0.5" data-label-en="See whether a place may accept all or only part of your crop." data-label-fil="Alamin kung buo o bahagi lamang ng ani ang maaaring tanggapin.">
                {isFil ? 'Alamin kung buo o bahagi lamang ng ani ang kayang tanggapin.' : 'Know immediately whether a destination takes all or part of your crop.'}
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3.5 p-4 bg-[#FFFDF8] border border-[#20251E]/10 rounded-xl">
            <div class="w-9 h-9 rounded-full bg-[#91AC67]/20 flex items-center justify-center shrink-0 text-[#597928]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10" />
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-[#20251E]" data-label-en="Compare before you travel" data-label-fil="Ihambing bago bumiyahe">
                {isFil ? 'Ihambing bago bumiyahe' : 'Compare before you travel'}
              </h3>
              <p class="text-sm text-[#4A5245] mt-0.5" data-label-en="Review estimated proceeds after hauling, before farm costs." data-label-fil="Tingnan ang tantiyang matitira matapos ang biyahe, bago ang gastos sa bukid.">
                {isFil ? 'Tingnan ang matitira matapos ibawas ang gastos sa pamasahe o transportasyon.' : 'Review gross proceeds minus entered hauling expense without false profit claims.'}
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
