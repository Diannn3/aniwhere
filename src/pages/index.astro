---
import BaseLayout from '../layouts/BaseLayout.astro';
import HarvestForm from '../components/harvest/HarvestForm.svelte';

const langParam = Astro.url.searchParams.get('lang');
const lang = langParam === 'fil' ? 'fil' : 'en';
const isFil = lang === 'fil';
---

<BaseLayout
  title={isFil ? 'AniWhere — Ano ang aanihin mo?' : 'AniWhere — What are you harvesting?'}
  description={isFil ? 'Ilagay ang ani, dami, lugar, at petsa upang makita ang mga posibleng outlet sa Laguna.' : 'Enter your harvest, quantity, origin, and date to see possible Laguna outlets.'}
  lang={lang}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:py-16">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(22rem,0.95fr)] lg:gap-12">
      <section class="min-w-0">
        <div class="max-w-2xl">
          <h1 class="max-w-[12ch] text-5xl font-bold leading-[0.98] tracking-[-0.035em] text-[#20251E] sm:text-6xl lg:text-7xl">
            {isFil ? 'Saan maaaring pumunta ang ani mo?' : 'Where can your harvest go?'}
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-[#4A5245] sm:text-xl">
            {isFil ? 'Ilagay ang ani mo para makita ang mga posibleng mapagbebentahan, ang kayang tanggapin ng bawat isa, at ang dapat kumpirmahin bago bumiyahe.' : 'Describe your harvest to see possible selling outlets, what each can accept, and what to confirm before you travel.'}
          </p>
        </div>

        <div class="mt-8 sm:mt-10">
          <HarvestForm client:load initialLang={lang} />
        </div>
      </section>

      <aside class="route-surface min-h-[30rem] rounded-2xl border border-[#20251E]/12 p-5 sm:p-7 lg:sticky lg:top-24 lg:min-h-[38rem]" aria-label={isFil ? 'Guhit ng ruta ng ani sa Laguna' : 'Illustrative harvest route in Laguna'}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-[#20251E] sm:text-3xl">{isFil ? 'Mula ani hanggang outlet' : 'From harvest to outlet'}</h2>
            <p class="mt-2 max-w-sm text-sm leading-relaxed text-[#4A5245]">{isFil ? 'Ang mga ruta at lokasyon ay guhit lamang. Makikita ang aktuwal na fit at impormasyon sa susunod na screen.' : 'Routes and locations are illustrative. The next screen shows the actual fit and evidence for each outlet.'}</p>
          </div>
          <span class="documentary-label shrink-0">{isFil ? 'Guhit-mapa' : 'Illustrative map'}</span>
        </div>

        <div class="mt-8 border-y border-[#20251E]/12 py-6 sm:mt-10 sm:py-8">
          <svg class="h-auto w-full" viewBox="0 0 620 440" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="water" x1="66" y1="70" x2="570" y2="320" gradientUnits="userSpaceOnUse">
                <stop stop-color="#4E7380" stop-opacity=".32" />
                <stop offset="1" stop-color="#4E7380" stop-opacity=".08" />
              </linearGradient>
              <linearGradient id="field" x1="89" y1="337" x2="491" y2="151" gradientUnits="userSpaceOnUse">
                <stop stop-color="#597928" stop-opacity=".72" />
                <stop offset="1" stop-color="#91AC67" stop-opacity=".28" />
              </linearGradient>
              <linearGradient id="route" x1="183" y1="318" x2="506" y2="130" gradientUnits="userSpaceOnUse">
                <stop stop-color="#6E3511" />
                <stop offset="1" stop-color="#597928" />
              </linearGradient>
            </defs>
            <path d="M28 88C117 42 201 98 279 75C364 50 433 53 591 22V194C507 238 404 198 321 230C229 264 130 218 28 264V88Z" fill="url(#water)" />
            <path d="M48 307C119 238 176 249 236 285C307 328 361 260 436 236C509 213 558 245 592 284V417H48V307Z" fill="url(#field)" />
            <path d="M77 367 176 300 283 418M198 418l107-122 94 122M342 418l88-112 135 58" stroke="#FFFDF8" stroke-opacity=".52" stroke-width="2" />
            <path class="route-line" d="M165 330C247 298 281 250 335 217C391 183 440 180 508 126" stroke="url(#route)" stroke-linecap="round" stroke-width="5" />
            <path d="M165 330C126 293 92 264 65 232" stroke="#6E3511" stroke-dasharray="6 8" stroke-linecap="round" stroke-width="3" />
            <path d="M351 83C399 101 451 93 510 58" stroke="#4E7380" stroke-opacity=".65" stroke-width="2" />
            <text x="344" y="141" fill="#4E7380" font-family="Source Sans 3, sans-serif" font-size="16" font-weight="700">Laguna de Bay</text>
            <text x="116" y="405" fill="#20251E" font-family="Source Sans 3, sans-serif" font-size="15" font-weight="700">Los Baños</text>
            <text x="430" y="108" fill="#20251E" font-family="Source Sans 3, sans-serif" font-size="15" font-weight="700">Santa Cruz</text>
            <text x="37" y="213" fill="#6E3511" font-family="Source Sans 3, sans-serif" font-size="14" font-weight="700">Calamba</text>
            <g transform="translate(165 330)"><path d="M0-16c-8.4 0-15.2 6.6-15.2 14.7C-15.2 10.1 0 26 0 26S15.2 10.1 15.2-1.3C15.2-9.4 8.4-16 0-16Z" fill="#6E3511"/><circle cy="-1" r="4.5" fill="#FFFDF8"/></g>
            <g transform="translate(508 126)"><path d="M0-16c-8.4 0-15.2 6.6-15.2 14.7C-15.2 10.1 0 26 0 26S15.2 10.1 15.2-1.3C15.2-9.4 8.4-16 0-16Z" fill="#597928"/><circle cy="-1" r="4.5" fill="#FFFDF8"/></g>
            <g transform="translate(65 232)"><path d="M0-13c-7.2 0-13 5.6-13 12.6C-13 9 0 22.5 0 22.5S13 9 13-.4C13-7.4 7.2-13 0-13Z" fill="#4E7380"/><circle cy="-.5" r="3.8" fill="#FFFDF8"/></g>
          </svg>
        </div>

        <dl class="mt-6 grid grid-cols-3 gap-3 text-sm">
          <div class="border-r border-[#20251E]/12 pr-3"><dt class="documentary-label">{isFil ? 'Una' : 'First'}</dt><dd class="mt-1 font-semibold text-[#20251E]">{isFil ? 'Ani' : 'Harvest'}</dd></div>
          <div class="border-r border-[#20251E]/12 pr-3"><dt class="documentary-label">{isFil ? 'Sunod' : 'Then'}</dt><dd class="mt-1 font-semibold text-[#20251E]">{isFil ? 'Fit' : 'Fit'}</dd></div>
          <div><dt class="documentary-label">{isFil ? 'Bago umalis' : 'Before travel'}</dt><dd class="mt-1 font-semibold text-[#20251E]">{isFil ? 'Kumpirmahin' : 'Confirm'}</dd></div>
        </dl>

        <p class="mt-8 border-t border-[#20251E]/12 pt-5 text-xs leading-relaxed text-[#4A5245]">{isFil ? 'Ang AniWhere ay tumutulong maghanda ng desisyon. Hindi nito ginagarantiyahan ang pagbili o pagreserba ng kapasidad.' : 'AniWhere helps prepare a decision. It does not guarantee a purchase or reserve capacity.'}</p>
      </aside>
    </div>
  </div>
</BaseLayout>
