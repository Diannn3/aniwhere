---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingSearch from '../components/harvest/LandingSearch.svelte';
import HarvestForm from '../components/harvest/HarvestForm.svelte';

const lang = Astro.url.searchParams.get('lang') === 'fil' ? 'fil' : 'en';
const isFil = lang === 'fil';
---

<BaseLayout
  title={isFil ? 'AniWhere — Saan maaaring pumunta ang ani mo?' : 'AniWhere — Where can your harvest go?'}
  description={isFil ? 'Hanapin ang mga posibleng outlet sa Laguna at alamin kung ano ang dapat kumpirmahin bago bumiyahe.' : 'Find possible outlets in Laguna and know what to confirm before you travel.'}
  lang={lang}
>
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-content">
      <h1 id="landing-title" data-i18n-en="Your harvest has somewhere to go." data-i18n-fil="May patutunguhan ang ani mo.">{isFil ? 'May patutunguhan ang ani mo.' : 'Your harvest has somewhere to go.'}</h1>
      <p data-i18n-en="Find possible outlets in Laguna. Know what to confirm before you travel." data-i18n-fil="Maghanap ng posibleng outlet sa Laguna. Alamin ang dapat kumpirmahin bago bumiyahe.">{isFil ? 'Maghanap ng posibleng outlet sa Laguna. Alamin ang dapat kumpirmahin bago bumiyahe.' : 'Find possible outlets in Laguna. Know what to confirm before you travel.'}</p>
      <div class="landing-search-slot">
        <LandingSearch client:load lang={lang} />
      </div>
    </div>
  </section>

  <section id="how-it-works" class="landing-story" aria-labelledby="story-title">
    <div class="landing-story-intro">
      <div>
        <h2 id="story-title" data-i18n-en="From harvest to a clearer next step." data-i18n-fil="Mula ani tungo sa mas malinaw na susunod na hakbang.">{isFil ? 'Mula ani tungo sa mas malinaw na susunod na hakbang.' : 'From harvest to a clearer next step.'}</h2>
      </div>
      <div class="landing-story-photo" role="img" data-aria-en="Illustrative image of a tomato harvest" data-aria-fil="Guhit ng ani ng kamatis" aria-label={isFil ? 'Guhit ng ani ng kamatis' : 'Illustrative image of a tomato harvest'}></div>
    </div>
    <ol class="landing-steps">
      <li><span>01</span><h3 data-i18n-en="Tell us your harvest" data-i18n-fil="Ilarawan ang ani">{isFil ? 'Ilarawan ang ani' : 'Tell us your harvest'}</h3><p data-i18n-en="Add the crop, quantity, origin, and ready date." data-i18n-fil="Ilagay ang pananim, dami, pinanggalingan, at petsang handa na.">{isFil ? 'Ilagay ang pananim, dami, pinanggalingan, at petsang handa na.' : 'Add the crop, quantity, origin, and ready date.'}</p></li>
      <li><span>02</span><h3 data-i18n-en="Compare fit and evidence" data-i18n-fil="Suriin ang tugma at ebidensiya">{isFil ? 'Suriin ang tugma at ebidensiya' : 'Compare fit and evidence'}</h3><p data-i18n-en="Review possible outlets, their evidence, and what remains uncertain." data-i18n-fil="Tingnan ang posibleng outlet, batayan ng impormasyon, at mga hindi pa tiyak.">{isFil ? 'Tingnan ang posibleng outlet, batayan ng impormasyon, at mga hindi pa tiyak.' : 'Review possible outlets, their evidence, and what remains uncertain.'}</p></li>
      <li><span>03</span><h3 data-i18n-en="Contact to confirm" data-i18n-fil="Kumpirmahin bago bumiyahe">{isFil ? 'Kumpirmahin bago bumiyahe' : 'Contact to confirm'}</h3><p data-i18n-en="Check capacity, price, and receiving terms before you travel." data-i18n-fil="Alamin muna ang kapasidad, presyo, at pagtanggap bago umalis.">{isFil ? 'Alamin muna ang kapasidad, presyo, at pagtanggap bago umalis.' : 'Check capacity, price, and receiving terms before you travel.'}</p></li>
    </ol>
  </section>

  <section class="landing-entry" aria-labelledby="entry-title">
    <div class="landing-entry-copy">
      <h2 id="entry-title" data-i18n-en="Start with what you have." data-i18n-fil="Ang desisyon ay nagsisimula sa ani mo.">{isFil ? 'Ang desisyon ay nagsisimula sa ani mo.' : 'Start with what you have.'}</h2>
    </div>
    <div id="harvest-details"><HarvestForm client:load initialLang={lang} /></div>
  </section>
</BaseLayout>

<style>
  :global(#main-content) { background: color-mix(in srgb, var(--rice-cream) 24%, var(--warm-surface)); }
  .landing-hero { position: relative; display: grid; min-height: min(740px, calc(100svh - 64px)); place-items: center; isolation: isolate; padding: 5rem 1.5rem 5.5rem; color: white; background: #293d28 url('/plates/landing-hero.webp') center / cover no-repeat; }
  .landing-hero::before { position: absolute; z-index: -1; inset: 0; content: ''; background: linear-gradient(90deg, rgba(14,30,18,.52), rgba(14,30,18,.4) 65%, rgba(14,30,18,.38)), linear-gradient(0deg, rgba(14,30,18,.48), transparent 45%); }
  .landing-hero-content { width: min(100%, 980px); text-align: center; }
  .landing-hero h1 { max-width: 14ch; margin: 0 auto; font-size: clamp(3.3rem, 7.1vw, 6rem); line-height: .99; letter-spacing: -.035em; text-wrap: balance; text-shadow: 0 2px 24px rgba(0,0,0,.25); }
  .landing-hero-content > p { max-width: 58ch; margin: 1.6rem auto 2rem; font-size: clamp(1.05rem, 1.8vw, 1.45rem); font-weight: 650; line-height: 1.4; text-wrap: balance; text-shadow: 0 2px 14px rgba(0,0,0,.55); }
  .landing-search-slot { max-width: 790px; margin: 0 auto; }
  .landing-story { max-width: 1440px; margin: auto; padding: clamp(3rem, 6vw, 6rem) clamp(1.25rem, 5vw, 5rem) 2.5rem; }
  .landing-story-intro { display: grid; grid-template-columns: 1fr minmax(220px, 30%); align-items: center; gap: clamp(2rem, 6vw, 7rem); }
  .landing-story h2, .landing-entry h2 { max-width: 18ch; font-size: clamp(2.3rem, 4vw, 4rem); line-height: 1.07; }
  .landing-story-intro p, .landing-entry p { max-width: 55ch; margin-top: 1.25rem; font-size: 1.15rem; color: #4a5245; }
  .landing-story-photo { height: 230px; border-radius: 12px; background: #91ac67 url('/plates/landing-harvest-original.webp') 88% 75% / 260% auto no-repeat; }
  .landing-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3rem; padding: 0; list-style: none; }
  .landing-steps li { border-top: 1px solid #9ea495; padding-top: 1rem; }
  .landing-steps span { color: #597928; font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .landing-steps h3 { margin-top: .5rem; font-size: 1.5rem; }
  .landing-steps p { max-width: 34ch; margin-top: .5rem; color: #4a5245; }
  .landing-entry { max-width: 1440px; margin: 0 auto; padding: 3rem clamp(1.25rem, 5vw, 5rem) 6rem; scroll-margin-top: 5rem; }
  .landing-entry-copy { margin-bottom: 2rem; }
  #harvest-details { width: 100%; scroll-margin-top: 5rem; }
  @media (max-width: 640px) { .landing-hero { min-height: 650px; padding: 3rem 1.25rem 5rem; background-position: 42% center; } .landing-hero h1 { font-size: clamp(3rem, 12vw, 4.5rem); } .landing-story-intro { grid-template-columns: 1fr; } .landing-story-photo { height: 190px; } .landing-steps { grid-template-columns: 1fr; gap: 2rem; margin-top: 3rem; } }
  /* The harvest image settles into view while the working search remains ready immediately. */
  @media (prefers-reduced-motion: no-preference) {
    .landing-hero::before { animation: field-arrive 700ms cubic-bezier(.16, 1, .3, 1) both; }
    .landing-hero h1 { animation: title-arrive 620ms 80ms cubic-bezier(.16, 1, .3, 1) both; }
    .landing-hero-content > p { animation: copy-arrive 420ms 180ms cubic-bezier(.16, 1, .3, 1) both; }
    .landing-search-slot { animation: copy-arrive 420ms 240ms cubic-bezier(.16, 1, .3, 1) both; }
  }
  @keyframes field-arrive { from { opacity: .55; } to { opacity: 1; } }
  @keyframes title-arrive { from { clip-path: inset(0 0 100%); } to { clip-path: inset(0); } }
  @keyframes copy-arrive { from { opacity: .65; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
</style>
