---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="max-w-2xl">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-[#20251E] leading-[1.15]">
        What are you harvesting?
      </h1>
      <p class="mt-4 text-lg text-[#4A5245] leading-relaxed">
        Find places to sell your harvest in Laguna. Tell us your harvest, and we show where it can realistically go.
      </p>
    </div>
  </div>
</BaseLayout>
