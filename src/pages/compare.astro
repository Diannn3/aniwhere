---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonExperience from '../components/compare/ComparisonExperience.svelte';

const title = 'AniWhere — Compare Market Options';
const description = 'Compare selling outlets side-by-side. Calculate proceeds after your entered hauling expense before you travel.';
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/compare"
>
  <ComparisonExperience client:only="svelte">
    <p slot="fallback" role="status" class="mx-auto max-w-5xl px-4 py-8 text-base">Binubuksan ang paghahambing… / Opening comparison…</p>
  </ComparisonExperience>
</BaseLayout>
