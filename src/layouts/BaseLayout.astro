---
import BrandMark from '../components/brand/BrandMark.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: 'en' | 'fil';
}

const {
  title = 'AniWhere — Harvest-Based Market Discovery for Farmers',
  description = 'Tell us your harvest. We show where it can realistically go. Market discovery and decision support for farmers in Laguna, Philippines.',
  currentPath = Astro.url.pathname,
  lang = 'en',
} = Astro.props;

const isFil = lang === 'fil';
const farmerNav = [
  { href: '/discover', label: isFil ? 'Maghanap' : 'Discover' },
  { href: '/saved', label: isFil ? 'Nai-save' : 'Saved' },
];

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);

const languageHref = (targetLang: 'en' | 'fil') => {
  const target = new URL(Astro.url);
  target.searchParams.set('lang', targetLang);
  return `${target.pathname}${target.search}${target.hash}`;
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col text-[#20251E] antialiased" data-lang={lang}>
    <a
      href="#main-content"
      class="sr-only fixed left-3 top-3 z-50 rounded-lg bg-[#597928] px-4 py-2 font-semibold text-[#FFFDF8] shadow-lg focus:not-sr-only"
    >
      {isFil ? 'Lumaktaw sa nilalaman' : 'Skip to main content'}
    </a>

    <div class="border-b border-[#20251E]/10 bg-[#FCECD8]/80 px-4 py-2 text-xs text-[#6E3511] sm:px-6">
      <div class="mx-auto flex max-w-7xl items-center gap-2">
        <strong class="font-semibold">{isFil ? 'Demo — halimbawang datos.' : 'Demo — sample data.'}</strong>
        <span>{isFil ? 'Kumpirmahin ang presyo, kapasidad, at kondisyon bago bumiyahe.' : 'Confirm price, capacity, and receiving terms before travelling.'}</span>
      </div>
    </div>

    <header class="sticky top-0 z-30 border-b border-[#20251E]/10 bg-[#FFFDF8]/92 px-4 backdrop-blur-md sm:px-6">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4">
        <a href={lang === 'fil' ? '/?lang=fil' : '/'} class="flex items-center rounded-lg transition-opacity hover:opacity-80" aria-label={isFil ? 'AniWhere tahanan' : 'AniWhere home'}>
          <BrandMark size="md" />
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label={isFil ? 'Pangunahing nabigasyon' : 'Main navigation'}>
          {farmerNav.map((item) => (
            <a
              href={`${item.href}${lang === 'fil' ? '?lang=fil' : ''}`}
              class={`rounded-lg px-3 py-2 text-sm font-semibold transition-colors ${
                isActive(item.href)
                  ? 'bg-[#597928] text-[#FFFDF8]'
                  : 'text-[#4A5245] hover:bg-[#FCECD8]/60 hover:text-[#20251E]'
              }`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <div class="inline-flex items-center rounded-lg border border-[#20251E]/15 bg-[#FFFDF8] p-1 text-xs font-bold" role="group" aria-label={isFil ? 'Piliin ang wika' : 'Select language'}>
            <a href={languageHref('en')} class={`rounded-md px-2 py-1 transition-colors ${lang === 'en' ? 'bg-[#20251E] text-[#FFFDF8]' : 'text-[#4A5245] hover:bg-[#FCECD8]'}`} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <a href={languageHref('fil')} class={`rounded-md px-2 py-1 transition-colors ${lang === 'fil' ? 'bg-[#20251E] text-[#FFFDF8]' : 'text-[#4A5245] hover:bg-[#FCECD8]'}`} aria-current={lang === 'fil' ? 'true' : undefined}>FIL</a>
          </div>
          <a
            href={`/buyer${lang === 'fil' ? '?lang=fil' : ''}`}
            class={`hidden min-h-10 items-center gap-2 rounded-lg border px-3 py-2 text-xs font-semibold transition-colors sm:inline-flex ${
              isActive('/buyer')
                ? 'border-[#597928] bg-[#597928] text-[#FFFDF8]'
                : 'border-[#20251E]/15 text-[#4A5245] hover:border-[#597928] hover:text-[#20251E]'
            }`}
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {isFil ? 'Para sa mamimili' : 'For buyers'}
          </a>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1 pb-24 md:pb-12">
      <slot />
    </main>

    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-[#20251E]/10 bg-[#FFFDF8]/95 px-4 py-2 backdrop-blur-md md:hidden" aria-label={isFil ? 'Nabigasyon sa mobile' : 'Mobile navigation'}>
      <div class="mx-auto grid max-w-sm grid-cols-3 gap-1">
        {[
          { href: '/', label: isFil ? 'Ani' : 'Harvest', icon: 'home' },
          { href: '/discover', label: isFil ? 'Maghanap' : 'Discover', icon: 'search' },
          { href: '/saved', label: isFil ? 'Nai-save' : 'Saved', icon: 'saved' },
        ].map((item) => (
          <a
            href={`${item.href}${lang === 'fil' ? '?lang=fil' : ''}`}
            class={`flex min-h-12 flex-col items-center justify-center gap-1 rounded-lg px-2 text-[11px] font-semibold transition-colors ${
              isActive(item.href) ? 'bg-[#FCECD8] text-[#6E3511]' : 'text-[#4A5245]'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.icon === 'home' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>}
            {item.icon === 'search' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>}
            {item.icon === 'saved' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-3-6 3V3Z"/></svg>}
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </nav>

    <footer class="border-t border-[#20251E]/10 bg-[#FFFDF8]/75 px-4 py-8 sm:px-6">
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-center text-xs text-[#4A5245] md:flex-row md:text-left">
        <div class="flex items-center gap-3"><BrandMark size="sm" /><span>&copy; 2026 AniWhere · NextGen Agri Hackathon Laguna</span></div>
        <p class="max-w-xl">{isFil ? 'Ang AniWhere ay tumutulong maghanda ng desisyon sa pagbebenta. Hindi ito garantiya ng bentahan o reserbasyon.' : 'AniWhere helps prepare a selling decision. It does not guarantee a sale or reserve capacity.'}</p>
      </div>
    </footer>
  </body>
</html>
