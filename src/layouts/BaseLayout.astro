---
import BrandMark from '../components/brand/BrandMark.astro';
import AniAssistant from '../components/ani/AniAssistant.svelte';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: 'en' | 'fil';
}

const {
  title = 'AniWhere — Harvest-Based Market Discovery for Farmers',
  description = 'Tell us your harvest. We show where it can realistically go. Market discovery and decision support for farmers in Laguna, Philippines.',
  currentPath = Astro.url.pathname,
  lang = 'en',
} = Astro.props;

const isFil = lang === 'fil';
const isBagsakanWorkspace = currentPath.startsWith('/bagsakan') || currentPath.startsWith('/buyer');
const showAni = import.meta.env.PUBLIC_ANI_ENABLED !== 'false' && !currentPath.startsWith('/buyer') && !currentPath.startsWith('/bagsakan');
const farmerNav = [
  { href: '/discover', label: isFil ? 'Maghanap' : 'Discover' },
  { href: '/saved', label: isFil ? 'Nai-save' : 'Saved' },
  { href: '/compare', label: isFil ? 'Ihambing' : 'Compare' },
];

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(`${path}/`);

const languageHref = (targetLang: 'en' | 'fil') => {
  const target = new URL(Astro.url);
  target.searchParams.set('lang', targetLang);
  return `${target.pathname}${target.search}${target.hash}`;
};

const harvestContextKeys = ['crop', 'kg', 'origin', 'ready', 'variety', 'grade', 'packaging'] as const;
const hasHarvestContext = ['crop', 'kg', 'origin'].every((key) => Astro.url.searchParams.has(key));
const farmerContextHref = (path: string) => {
  const target = new URL(path, Astro.url.origin);
  if ((path === '/discover' || path === '/saved' || path === '/compare') && hasHarvestContext) {
    for (const key of harvestContextKeys) {
      const value = Astro.url.searchParams.get(key);
      if (value) target.searchParams.set(key, value);
    }
  }
  if (lang === 'fil') target.searchParams.set('lang', 'fil');
  return `${target.pathname}${target.search}`;
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#597928" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col text-[#20251E] antialiased" data-lang={lang}>
    <a
      data-ani-background
      href="#main-content"
      class="sr-only fixed left-3 top-3 z-50 rounded-lg bg-[#597928] px-4 py-2 font-semibold text-[#FFFDF8] shadow-lg focus:not-sr-only"
    >
      <span data-i18n-en="Skip to main content" data-i18n-fil="Lumaktaw sa nilalaman">{isFil ? 'Lumaktaw sa nilalaman' : 'Skip to main content'}</span>
    </a>


    <header data-ani-background class="sticky top-0 z-30 border-b border-[#20251E]/25 bg-[#FFFDF8] px-4 sm:px-6">
      <div class="mx-auto flex h-16 max-w-[92rem] items-center justify-between gap-4">
        <a href={lang === 'fil' ? '/?lang=fil' : '/'} data-route-href="/" data-aria-en="AniWhere home" data-aria-fil="AniWhere tahanan" class="flex items-center rounded-lg transition-opacity hover:opacity-80" aria-label={isFil ? 'AniWhere tahanan' : 'AniWhere home'}>
          <BrandMark size="md" />
        </a>

        <nav class="hidden items-center gap-1 md:flex" data-aria-en="Main navigation" data-aria-fil="Pangunahing nabigasyon" aria-label={isFil ? 'Pangunahing nabigasyon' : 'Main navigation'}>
          {farmerNav.map((item) => (
            <a
              href={farmerContextHref(item.href)}
              data-route-href={item.href}
              data-i18n-en={item.href === '/discover' ? 'Discover' : item.href === '/saved' ? 'Saved' : 'Compare'}
              data-i18n-fil={item.href === '/discover' ? 'Maghanap' : item.href === '/saved' ? 'Nai-save' : 'Ihambing'}
              class={`almanac-button border-b-2 px-3 py-2 text-sm transition-colors ${
                isActive(item.href)
                  ? 'border-[#597928] text-[#20251E]'
                  : 'border-transparent text-[#4A5245] hover:border-[#91AC67] hover:text-[#20251E]'
              }`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          {showAni && <button
              id="ani-mobile-trigger"
              type="button"
              class="grid h-11 w-11 place-items-center rounded-xl border border-[#20251E]/15 bg-white shadow-[0_10px_28px_-20px_rgba(32,37,30,.55)] md:hidden"
              data-aria-en="Ask Ani"
              data-aria-fil="Tanungin si Ani"
              aria-label={isFil ? 'Tanungin si Ani' : 'Ask Ani'}
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="ani-panel"
            >
              <img src="/ani/ani-avatar.webp" alt="" aria-hidden="true" class="h-8 w-8 rounded-full object-cover" />
            </button>}
          <p class="hidden border-r border-[#20251E]/20 pr-3 text-xs text-[#6E3511] sm:block" data-i18n-en="Demo — sample data" data-i18n-fil="Demo — halimbawang datos">{isFil ? 'Demo — halimbawang datos' : 'Demo — sample data'}</p>
          <div class="inline-flex items-center rounded-lg border border-[#20251E]/15 bg-[#FFFDF8] p-1 text-xs font-bold" role="group" data-aria-en="Select language" data-aria-fil="Piliin ang wika" aria-label={isFil ? 'Piliin ang wika' : 'Select language'}>
            <a href={languageHref('en')} data-language-target="en" class={`rounded-md px-2 py-1 transition-colors ${lang === 'en' ? 'bg-[#20251E] text-[#FFFDF8]' : 'text-[#4A5245] hover:bg-[#FCECD8]'}`} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <a href={languageHref('fil')} data-language-target="fil" class={`rounded-md px-2 py-1 transition-colors ${lang === 'fil' ? 'bg-[#20251E] text-[#FFFDF8]' : 'text-[#4A5245] hover:bg-[#FCECD8]'}`} aria-current={lang === 'fil' ? 'true' : undefined}>FIL</a>
          </div>
          <a
            href={`/bagsakan${lang === 'fil' ? '?lang=fil' : ''}`}
            data-route-href="/bagsakan"
            class={`hidden min-h-10 items-center gap-2 rounded-lg border px-3 py-2 text-xs font-semibold transition-colors sm:inline-flex ${
              isActive('/bagsakan') || isActive('/buyer')
                ? 'border-[#597928] bg-[#486320] text-[#FFFDF8]'
                : 'border-[#20251E]/15 text-[#4A5245] hover:border-[#597928] hover:text-[#20251E]'
            }`}
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span data-i18n-en="For bagsakan" data-i18n-fil="Para sa bagsakan">{isFil ? 'Para sa bagsakan' : 'For bagsakan'}</span>
          </a>
        </div>
      </div>
    </header>

    <main data-ani-background id="main-content" class={`page-enter min-w-0 flex-1 overflow-x-clip ${isBagsakanWorkspace ? 'pb-12' : 'pb-24 md:pb-12'}`}>
      <slot />
    </main>

    {!isBagsakanWorkspace && <nav data-ani-background class="fixed inset-x-0 bottom-0 z-40 border-t border-[#20251E]/10 bg-[#FFFDF8]/95 px-4 py-2 backdrop-blur-md md:hidden" data-aria-en="Mobile navigation" data-aria-fil="Nabigasyon sa mobile" aria-label={isFil ? 'Nabigasyon sa mobile' : 'Mobile navigation'}>
      <div class="mx-auto grid max-w-md grid-cols-4 gap-1">
        {[
          { href: '/', label: isFil ? 'Ani ko' : 'Harvest', icon: 'home' },
          { href: '/saved', label: isFil ? 'Nai-save' : 'Saved', icon: 'saved' },
          { href: '/discover', label: isFil ? 'Maghanap' : 'Discover', icon: 'search' },
          { href: '/compare', label: isFil ? 'Ihambing' : 'Compare', icon: 'compare' },
        ].map((item) => (
          <a
            href={farmerContextHref(item.href)}
            data-route-href={item.href}
            class={`flex min-h-12 flex-col items-center justify-center gap-1 rounded-lg px-1 text-[11px] font-semibold transition-colors ${
              item.href === '/discover' ? 'text-[#20251E]' : isActive(item.href) ? 'bg-[#FCECD8] text-[#6E3511]' : 'text-[#4A5245]'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.icon === 'home' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>}
            {item.icon === 'search' && <span class="grid h-12 w-12 place-items-center rounded-full bg-[#486320] text-[#FFFDF8] shadow-[0_6px_16px_-8px_rgba(32,37,30,.7)]"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg></span>}
            {item.icon === 'saved' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-3-6 3V3Z"/></svg>}
            {item.icon === 'compare' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 3v18M17 3v18M3 7h8M13 17h8"/><path d="m8 4 3 3-3 3M16 14l-3 3 3 3"/></svg>}
            <span data-i18n-en={item.href === '/' ? 'Harvest' : item.href === '/discover' ? 'Discover' : item.href === '/saved' ? 'Saved' : 'Compare'} data-i18n-fil={item.href === '/' ? 'Ani ko' : item.href === '/discover' ? 'Maghanap' : item.href === '/saved' ? 'Nai-save' : 'Ihambing'}>{item.label}</span>
          </a>
        ))}
      </div>
    </nav>}

    {showAni && <AniAssistant client:load initialLang={lang} />}

    <footer data-ani-background class="border-t border-[#20251E]/25 bg-[#FFFDF8] px-4 py-6 sm:px-6">
      <div class="mx-auto flex max-w-[92rem] flex-col items-center justify-between gap-4 text-center text-xs text-[#4A5245] md:flex-row md:text-left">
        <BrandMark size="sm" />
        <p class="max-w-xl" data-i18n-en="Prepare the trip. Confirm price, capacity, and receiving terms before travelling." data-i18n-fil="Ihanda ang biyahe. Kumpirmahin ang presyo, kapasidad, at kondisyon bago bumiyahe.">{isFil ? 'Ihanda ang biyahe. Kumpirmahin ang presyo, kapasidad, at kondisyon bago bumiyahe.' : 'Prepare the trip. Confirm price, capacity, and receiving terms before travelling.'}</p>
        {!isBagsakanWorkspace && <a href={`/bagsakan${lang === 'fil' ? '?lang=fil' : ''}`} data-route-href="/bagsakan" class="inline-flex min-h-11 items-center font-semibold text-[#486320] underline underline-offset-4" data-i18n-en="For Bagsakan" data-i18n-fil="Para sa Bagsakan">{isFil ? 'Para sa Bagsakan' : 'For Bagsakan'}</a>}
      </div>
    </footer>

    {import.meta.env.PROD && <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Offline support is optional; the core app must remain usable if registration fails.
          });
        }, { once: true });
      }
    </script>}

    {!import.meta.env.PROD && <script is:inline>
      if ('serviceWorker' in navigator) {
        void navigator.serviceWorker.getRegistrations().then((registrations) =>
          Promise.all(registrations.map((registration) => registration.unregister())),
        );
        void caches.keys().then((keys) =>
          Promise.all(
            keys
              .filter((key) => key.startsWith('aniwhere-core-'))
              .map((key) => caches.delete(key)),
          ),
        );
      }
    </script>}

    <script is:inline>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const activeLang = params.get('lang') === 'fil' ? 'fil' : 'en';
        document.documentElement.lang = activeLang;
        document.body.dataset.lang = activeLang;

        document.querySelectorAll('[data-i18n-en][data-i18n-fil]').forEach((element) => {
          const value = element.getAttribute(activeLang === 'fil' ? 'data-i18n-fil' : 'data-i18n-en');
          if (value !== null) element.textContent = value;
        });

        document.querySelectorAll('[data-aria-en][data-aria-fil]').forEach((element) => {
          const value = element.getAttribute(activeLang === 'fil' ? 'data-aria-fil' : 'data-aria-en');
          if (value !== null) element.setAttribute('aria-label', value);
        });

        const updateLanguageLinks = () => {
          document.querySelectorAll('a[data-language-target]').forEach((element) => {
            const target = element.getAttribute('data-language-target');
            if (!target) return;
            const url = new URL(window.location.href);
            url.searchParams.set('lang', target);
            element.setAttribute('href', url.pathname + url.search + url.hash);

            const selected = target === activeLang;
            if (selected) element.setAttribute('aria-current', 'true');
            else element.removeAttribute('aria-current');
            element.classList.toggle('bg-[#20251E]', selected);
            element.classList.toggle('text-[#FFFDF8]', selected);
            element.classList.toggle('text-[#4A5245]', !selected);
            element.classList.toggle('hover:bg-[#FCECD8]', !selected);
          });
        };

        const aniMobileTrigger = document.getElementById('ani-mobile-trigger');
        aniMobileTrigger?.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('aniwhere:open-ani'));
        });

        const harvestContextKeys = ['crop', 'kg', 'origin', 'ready', 'variety', 'grade', 'packaging'];
        const updateRouteLinks = () => {
          const currentParams = new URLSearchParams(window.location.search);
          const hasHarvestContext = ['crop', 'kg', 'origin'].every((key) => currentParams.has(key));
          document.querySelectorAll('a[data-route-href]').forEach((element) => {
            const route = element.getAttribute('data-route-href');
            if (!route) return;
            const url = new URL(route, window.location.origin);

            if ((route === '/discover' || route === '/saved' || route === '/compare') && hasHarvestContext) {
              for (const key of harvestContextKeys) {
                const value = currentParams.get(key);
                if (value) url.searchParams.set(key, value);
              }
            }

            if (activeLang === 'fil') url.searchParams.set('lang', 'fil');
            element.setAttribute('href', url.pathname + url.search);
          });
        };
        const updateLinks = () => { updateLanguageLinks(); updateRouteLinks(); };
        updateLinks();
        window.addEventListener('aniwhere:harvest-url-change', updateLinks);
      })();
    </script>
  </body>
</html>
